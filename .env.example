# =====================================================================
# Enterprise Copilot — 环境变量样例（复制为 .env）
# =====================================================================

# ---------------- 共享 ----------------
APP_ENV=dev
LOG_LEVEL=INFO

# ---------------- 控制面 Platform API ----------------
PLATFORM_DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/copilot
# 本地零依赖开发：
# PLATFORM_DATABASE_URL=sqlite+aiosqlite:///./var/platform.db
PLATFORM_JWT_SECRET=change-me-in-prod-please-32bytes-min
PLATFORM_JWT_TTL_MINUTES=720
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@corp.local
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=Copilot@2026
PLATFORM_CORS_ORIGINS=http://localhost:8501,http://localhost:5173

# ---------------- 执行面 Runtime Service ----------------
RUNTIME_REDIS_URL=redis://redis:6379/0
RUNTIME_CHECKPOINT_BACKEND=postgres        # postgres | sqlite | memory
RUNTIME_CHECKPOINT_DSN=postgresql://copilot:copilot@postgres:5432/copilot
# RUNTIME_CHECKPOINT_BACKEND=sqlite
# RUNTIME_CHECKPOINT_DSN=./var/runtime.db

# 平台鉴权：Runtime 用 platform 签发的 JWT 做二次校验
RUNTIME_JWT_SECRET=change-me-in-prod-please-32bytes-min
RUNTIME_PLATFORM_BASE_URL=http://platform-api:8000

# LLM（OpenAI 兼容协议；DeepSeek / Qwen / vLLM 均可）
RUNTIME_LLM_BASE_URL=https://api.deepseek.com/v1
RUNTIME_LLM_API_KEY=
RUNTIME_LLM_MODEL=deepseek-chat
RUNTIME_LLM_CHEAP_MODEL=deepseek-chat
RUNTIME_LLM_TIMEOUT_SECONDS=60

# 单次运行成本上限（USD），超限降级到 cheap 模型，再超限则 402
RUNTIME_RUN_BUDGET_USD=0.05
RUNTIME_PRICE_IN_PER_1K=0.00027
RUNTIME_PRICE_OUT_PER_1K=0.0011

# ---------------- RAG ----------------
RAG_VECTOR_BACKEND=memory                 # memory | qdrant
RAG_QDRANT_URL=http://qdrant:6333
RAG_COLLECTION=copilot_chunks
RAG_EMBEDDING_PROVIDER=hashing            # hashing | sentence-transformers | openai
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIM=512
RAG_CHUNKER=semantic                      # recursive | semantic
RAG_CHUNK_SIZE=480
RAG_CHUNK_OVERLAP=80
RAG_RRF_K=60
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_QUERY_TRANSFORM=off                   # off | multi_query（受控领域同义词扩展）
RAG_QUERY_VARIANTS=3
RAG_RERANK_TOP_N=5
RAG_RERANKER=heuristic                    # heuristic | cross-encoder | none
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_SCORE_THRESHOLD=0.55

# ---------------- MCP ----------------
MCP_OPS_URL=http://mcp-ops:8765/mcp
# 本地 stdio 模式（不启 mcp-ops 容器时）：
# MCP_OPS_COMMAND=python
# MCP_OPS_ARGS=-m,runtime.mcp_layer.server,--transport,stdio
MCP_TOOL_TIMEOUT_SECONDS=8
MCP_TOOL_MAX_RETRIES=2
MCP_BREAKER_FAIL_THRESHOLD=5
MCP_BREAKER_RESET_SECONDS=30

# ---------------- 可观测性 ----------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-copilot
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ---------------- 前端 ----------------
COPILOT_API_BASE=http://localhost:8001
COPILOT_TOKEN=
